# Copy to .env and edit:   cp .env.example .env

# Public HTTPS URL where GitHub can reach Woodpecker (NO trailing slash).
# Local machine: use a tunnel, e.g.  cloudflared tunnel --url http://localhost:8000
#                -> gives https://something.trycloudflare.com
# Server/VPS:    your domain, e.g. https://ci.example.com
WOODPECKER_HOST=https://something.trycloudflare.com

# Your GitHub username (becomes the Woodpecker admin)
GITHUB_USERNAME=your-github-username

# Shared secret between Woodpecker server and agent. Generate with:  openssl rand -hex 32
WOODPECKER_AGENT_SECRET=change-me

# From your GitHub OAuth App (README step 3)
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=
